<Application x:Class="MagentaBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Design/DesignLanguage.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- App-specific: a checkbox used where a raw checkbox reads better than a switch. -->
      <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Stroke}"
                        Background="Transparent" VerticalAlignment="Center" />
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <!-- No stroke when on: the fill must reach the edge, or the 1 px border
                       leaves a dark rim inside a 15 px box. -->
                  <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Box" Property="BorderThickness" Value="0" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A compact slider for the two panel brightness values. -->
      <Style x:Key="WarmSlider" TargetType="Slider">
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Grid VerticalAlignment="Center">
                <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Control}"
                        BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" />
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Opacity="0" Focusable="False" IsTabStop="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="14" Height="14" Cursor="Hand">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Ellipse x:Name="E" Fill="{DynamicResource Brush.Accent}" Width="14" Height="14" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="E" Property="Fill" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Opacity="0" Focusable="False" IsTabStop="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
